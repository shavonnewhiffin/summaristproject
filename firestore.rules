rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only access their own customer data.
    match /customers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated users to create checkout sessions.
      match /checkout_sessions/{sessionId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Subscription status is written by the Stripe extension (admin
      // access, bypasses rules) — the client only needs to read it.
      match /subscriptions/{subscriptionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Keep everything else locked down for now.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}